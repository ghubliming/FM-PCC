<mujoco model="UAV Corridor Scene">
  <include file="../quadrotor_modified.xml"/>
  <compiler meshdir="../assets" texturedir="../assets"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="32" height="32"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
    <material name="wall" rgba="0.7 0.7 0.7 1"/>
  </asset>

  <worldbody>
    <light name="overhead" pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="10 10 0.05" material="groundplane"/>

    <!-- Two parallel walls 1 m apart on the y axis, 4 m long along x, 1.5 m tall.
         Corridor centerline runs from (-2, 0, *) to (+2, 0, *). -->
    <geom name="wall_y_neg" type="box" pos="0 -0.5 0.75" size="2.0 0.05 0.75" material="wall"/>
    <geom name="wall_y_pos" type="box" pos="0  0.5 0.75" size="2.0 0.05 0.75" material="wall"/>
  </worldbody>
</mujoco>
