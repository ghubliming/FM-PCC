<mujoco model="UAV Pillars Scene">
  <include file="../quadrotor_modified.xml"/>
  <compiler meshdir="../assets" texturedir="../assets"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="32" height="32"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
    <material name="pillar" rgba="0.85 0.55 0.25 1"/>
  </asset>

  <worldbody>
    <light name="overhead" pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="10 10 0.05" material="groundplane"/>

    <!-- 6 vertical cylinder pillars in two staggered columns.
         Column A at y = -0.6, Column B at y = +0.6, x ∈ {-2, 0, +2}.
         Drone weaves between them. Radius 0.12 m, height 2 m. -->
    <geom name="pillar_A1" type="cylinder" pos="-2.0 -0.6 1.0" size="0.12 1.0" material="pillar"/>
    <geom name="pillar_A2" type="cylinder" pos=" 0.0 -0.6 1.0" size="0.12 1.0" material="pillar"/>
    <geom name="pillar_A3" type="cylinder" pos=" 2.0 -0.6 1.0" size="0.12 1.0" material="pillar"/>
    <geom name="pillar_B1" type="cylinder" pos="-2.0  0.6 1.0" size="0.12 1.0" material="pillar"/>
    <geom name="pillar_B2" type="cylinder" pos=" 0.0  0.6 1.0" size="0.12 1.0" material="pillar"/>
    <geom name="pillar_B3" type="cylinder" pos=" 2.0  0.6 1.0" size="0.12 1.0" material="pillar"/>
  </worldbody>
</mujoco>
